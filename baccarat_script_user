(function() {
    'use strict';

    // Your code here...
})();
// ==UserScript==
// @name         Baccarat Ultimate AI Engine Pro - Authorization & Expiration Edition
// @namespace    http://tampermonkey.net/
// @version      33.0
// @description  黑透奢華 UI，加入 12 天系統授權過期機制，過期後自動跳出「系統授權已回復」提示並鎖定預測功能
// @author       程式夥伴
// @match        *://*.ofalive99.net/*
// @match        *://gsa.ofalive99.net/*
// @run-at       document-end
// @allFrames    true
// @grant        none
// ==/Script==

(function () {
    'use strict';

    const isMTSite = location.hostname.includes('ofalive99.net') || document.title.includes('MT');
    if (!isMTSite) return;

    if (document.getElementById('baccarat-ultimate-engine') || document.getElementById('baccarat-expired-modal')) return;

    // --- 計算預設 12 天後過期日期 (YYYY-MM-DD) ---
    function getFutureExpireDate(days = 12) {
        const d = new Date();
        d.setDate(d.getDate() + days);
        const yyyy = d.getFullYear();
        const mm = String(d.getMonth() + 1).padStart(2, '0');
        const dd = String(d.getDate()).padStart(2, '0');
        return `${yyyy}-${mm}-${dd}`;
    }

    // ==========================================
    // ⚙️ 【核心變數與授權設定區】
    // ==========================================
    const CONFIG = {
        BRAND_NAME: "龍盈科技【MT百家樂】",
        SCAN_INTERVAL: 400,
        EXPIRE_DATE: getFutureExpireDate(12) // 預設為當前算起 12 天後，也可直接指定日期如 "2026-09-13"
    };

    // --- 授權時間驗證 ---
    function isAuthorizationValid() {
        const now = new Date();
        const expire = new Date(`${CONFIG.EXPIRE_DATE}T23:59:59`);
        return now <= expire;
    }

    // --- 顯示過期彈窗 (還原截圖視覺樣式) ---
    function showExpiredModal() {
        if (document.getElementById('baccarat-expired-modal')) return;

        const modal = document.createElement('div');
        modal.id = 'baccarat-expired-modal';
        modal.style.cssText = `
            position: fixed;
            top: 20px;
            right: 20px;
            z-index: 99999999;
            background: rgba(18, 18, 24, 0.95);
            backdrop-filter: blur(15px);
            -webkit-backdrop-filter: blur(15px);
            border: 1px solid rgba(239, 68, 68, 0.4);
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.8), 0 0 15px rgba(239, 68, 68, 0.2);
            border-radius: 12px;
            padding: 14px 18px;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            min-width: 220px;
            color: #ffffff;
            user-select: none;
        `;

        modal.innerHTML = `
            <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 8px;">
                <div style="width: 18px; height: 18px; background: #ef4444; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #ffffff; font-weight: 900; font-size: 13px; line-height: 1;">−</div>
                <div style="font-size: 15px; font-weight: 800; color: #f87171; letter-spacing: 0.5px;">系統授權已回復</div>
            </div>
            <div style="font-size: 12px; color: #cbd5e1; font-weight: 600; margin-left: 26px; margin-bottom: 4px;">
                兌日: ${CONFIG.EXPIRE_DATE}
            </div>
            <div style="font-size: 11px; color: #94a3b8; margin-left: 26px;">
                請聯絡【龍盈科技】續費啟用
            </div>
        `;

        document.body.appendChild(modal);
    }

    // 啟動授權檢查：若過期則直接跳出彈窗並終止執行
    if (!isAuthorizationValid()) {
        showExpiredModal();
        return;
    }

    // ==========================================
    // ✦ 【主程式：授權有效時載入 AI 預測引擎】
    // ==========================================
    let autoDetectEnabled = false;
    let lastB = -1, lastP = -1, lastT = -1;
    let gameSequence = [];

    const container = document.createElement('div');
    container.id = 'baccarat-ultimate-engine';
    container.style.cssText = `
        position: fixed;
        top: 15px;
        right: 15px;
        z-index: 9999999;
        background: rgba(12, 12, 18, 0.92);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        color: #f8fafc;
        padding: 10px;
        border-radius: 14px;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.9), 0 0 20px rgba(212, 175, 55, 0.25);
        width: 165px;
        border: 1px solid rgba(212, 175, 55, 0.5);
        box-sizing: border-box;
        user-select: none;
        touch-action: none;
        transition: border-color 0.3s, box-shadow 0.3s;
    `;

    const styleElem = document.createElement('style');
    styleElem.innerHTML = `
        .gold-foil-text {
            background: linear-gradient(135deg, #fff7ad 0%, #ffa200 35%, #ffd700 70%, #aa771c 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            font-weight: 800;
            filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.95));
        }
        .gold-border-box {
            border: 1px solid rgba(212, 175, 55, 0.35);
            box-shadow: inset 0 0 10px rgba(212, 175, 55, 0.08);
            transition: all 0.3s ease;
        }
        .luxury-btn {
            background: linear-gradient(180deg, rgba(30,30,42,0.8) 0%, rgba(15,15,22,0.9) 100%);
            border: 1px solid rgba(212, 175, 55, 0.3);
            color: #d4af37;
            transition: all 0.2s;
        }
        .luxury-btn:hover {
            border-color: rgba(212, 175, 55, 0.8);
            filter: brightness(1.2);
        }
    `;
    document.head.appendChild(styleElem);

    container.innerHTML = `
        <div id="panel-header" style="margin-bottom:8px; border-bottom:1px solid rgba(212, 175, 55, 0.3); padding-bottom:5px; cursor:move; text-align:center;">
            <div class="gold-foil-text" style="font-size:10px; font-weight:800; margin-bottom:2px; letter-spacing:0.2px;">
                ${CONFIG.BRAND_NAME}
            </div>
            <div id="header-time-line" style="font-size:9px; color:#cbd5e1; font-weight:600; letter-spacing:0.3px;">
                0000-00-00 00:00:00
            </div>
        </div>

        <div style="display:flex; gap:5px; margin-bottom:6px;">
            <button id="btn-toggle-auto" class="luxury-btn" style="flex:1; padding:3px 0; border-radius:5px; font-size:9px; font-weight:700; cursor:pointer;">自動: 關</button>
            <button id="btn-clear" class="luxury-btn" style="background:rgba(239, 68, 68, 0.15); color:#fca5a5; border-color:rgba(239, 68, 68, 0.3); padding:3px 6px; border-radius:5px; font-size:9px; font-weight:600; cursor:pointer;">重置</button>
        </div>

        <div class="gold-border-box" style="background:rgba(8, 8, 12, 0.9); padding:8px; border-radius:8px; margin-bottom:6px;">
            <div style="font-size:9px; color:#d4af37; font-weight:700; margin-bottom:6px; display:flex; justify-content:space-between; align-items:center;">
                <span>✦ 實時牌勢統計</span>
                <span id="stat-total-label" style="color:#94a3b8;">總局數: 0</span>
            </div>
            
            <div style="display:grid; grid-template-columns: 1fr 1fr 1fr; gap:4px; text-align:center;">
                <div style="background:rgba(239, 68, 68, 0.15); border:1px solid rgba(239, 68, 68, 0.35); border-radius:6px; padding:4px 2px;">
                    <div style="font-size:10px; color:#f87171; font-weight:800;">莊</div>
                    <div id="cnt-banker" style="font-size:14px; color:#ffffff; font-weight:800; margin-top:1px;">0</div>
                </div>
                <div style="background:rgba(59, 130, 246, 0.15); border:1px solid rgba(59, 130, 246, 0.35); border-radius:6px; padding:4px 2px;">
                    <div style="font-size:10px; color:#60a5fa; font-weight:800;">閒</div>
                    <div id="cnt-player" style="font-size:14px; color:#ffffff; font-weight:800; margin-top:1px;">0</div>
                </div>
                <div style="background:rgba(16, 185, 129, 0.15); border:1px solid rgba(16, 185, 129, 0.35); border-radius:6px; padding:4px 2px;">
                    <div style="font-size:10px; color:#34d399; font-weight:800;">和</div>
                    <div id="cnt-tie" style="font-size:14px; color:#ffffff; font-weight:800; margin-top:1px;">0</div>
                </div>
            </div>

            <div style="display:flex; justify-content:space-between; margin-top:6px; padding-top:5px; border-top:1px dashed rgba(212,175,55,0.25); font-size:10px; font-weight:700;">
                <span style="color:#f87171;">莊勢: <b id="stat-banker-rate">0%</b></span>
                <span style="color:#60a5fa;">閒勢: <b id="stat-player-rate">0%</b></span>
            </div>
        </div>

        <div id="prediction-card" class="gold-border-box" style="background:linear-gradient(145deg, rgba(18, 18, 26, 0.95), rgba(28, 28, 38, 0.95)); padding:8px; border-radius:8px; text-align:center;">
            <div style="font-size:9px; color:#818cf8; font-weight:700; margin-bottom:3px; letter-spacing:0.5px;">✦ 牌勢預測</div>
            <div id="rec-target" class="gold-foil-text" style="font-size:17px; font-weight:800; letter-spacing:1.5px; padding:2px 0;">【 待啟動 】</div>
        </div>
    `;

    document.body.appendChild(container);

    (function initDraggable() {
        const header = container.querySelector('#panel-header');
        let isDragging = false;
        let currentX = 0, currentY = 0, initialX = 0, initialY = 0;
        let xOffset = 0, yOffset = 0;

        header.addEventListener('mousedown', dragStart);
        document.addEventListener('mousemove', drag);
        document.addEventListener('mouseup', dragEnd);

        header.addEventListener('touchstart', dragStart, { passive: false });
        document.addEventListener('touchmove', drag, { passive: false });
        document.addEventListener('touchend', dragEnd);

        function dragStart(e) {
            if (e.type === "touchstart") {
                initialX = e.touches[0].clientX - xOffset;
                initialY = e.touches[0].clientY - yOffset;
            } else {
                initialX = e.clientX - xOffset;
                initialY = e.clientY - yOffset;
            }
            if (e.target === header || header.contains(e.target)) {
                isDragging = true;
            }
        }

        function drag(e) {
            if (isDragging) {
                e.preventDefault();
                if (e.type === "touchmove") {
                    currentX = e.touches[0].clientX - initialX;
                    currentY = e.touches[0].clientY - initialY;
                } else {
                    currentX = e.clientX - initialX;
                    currentY = e.clientY - initialY;
                }
                xOffset = currentX;
                yOffset = currentY;
                container.style.transform = `translate3d(${currentX}px, ${currentY}px, 0)`;
            }
        }

        function dragEnd() {
            initialX = currentX;
            initialY = currentY;
            isDragging = false;
        }
    })();

    function getFormattedStandardDateTime() {
        const now = new Date();
        const yyyy = now.getFullYear();
        const mm = String(now.getMonth() + 1).padStart(2, '0');
        const dd = String(now.getDate()).padStart(2, '0');
        const hh = String(now.getHours()).padStart(2, '0');
        const min = String(now.getMinutes()).padStart(2, '0');
        const ss = String(now.getSeconds()).padStart(2, '0');
        return `${yyyy}-${mm}-${dd} ${hh}:${min}:${ss}`;
    }

    function updateHeaderTime() {
        const timeEl = document.getElementById('header-time-line');
        if (timeEl) {
            timeEl.innerText = getFormattedStandardDateTime();
        }
    }

    function extractLiveScores() {
        const allElements = document.querySelectorAll('div, span, p, td');
        for (let el of allElements) {
            if (container.contains(el)) continue;
            const txt = (el.innerText || "").trim();
            const match = txt.match(/^莊\s*(\d+)\D+閒\s*(\d+)\D+和\s*(\d+)$/);
            if (match) {
                return {
                    b: parseInt(match[1], 10),
                    p: parseInt(match[2], 10),
                    t: parseInt(match[3], 10)
                };
            }
        }
        for (let el of allElements) {
            if (container.contains(el)) continue;
            const txt = (el.innerText || "").trim();
            const match = txt.match(/莊\s*[:：]?\s*(\d+)\D+閒\s*[:：]?\s*(\d+)\D+和\s*[:：]?\s*(\d+)/);
            if (match && txt.length < 30) {
                return {
                    b: parseInt(match[1], 10),
                    p: parseInt(match[2], 10),
                    t: parseInt(match[3], 10)
                };
            }
        }
        return null;
    }

    function updateCountsAndPredict(b, p, t) {
        const total = b + p;
        const grandTotal = b + p + t;

        document.getElementById('cnt-banker').innerText = b;
        document.getElementById('cnt-player').innerText = p;
        document.getElementById('cnt-tie').innerText = t;
        document.getElementById('stat-total-label').innerText = `總局數: ${grandTotal}`;

        updateHeaderTime();

        const elBankerRate = document.getElementById('stat-banker-rate');
        const elPlayerRate = document.getElementById('stat-player-rate');
        const elTarget = document.getElementById('rec-target');
        const predCard = document.getElementById('prediction-card');

        if (total === 0) {
            elBankerRate.innerText = '0%';
            elPlayerRate.innerText = '0%';
            elTarget.innerText = '【 準備中 】';
            elTarget.style.color = '#d4af37';
            if (predCard) {
                predCard.style.borderColor = 'rgba(212, 175, 55, 0.35)';
                predCard.style.boxShadow = 'none';
            }
            return;
        }

        const bRate = Math.round((b / total) * 100);
        const pRate = Math.round((p / total) * 100);
        elBankerRate.innerText = `${bRate}%`;
        elPlayerRate.innerText = `${pRate}%`;

        let bankerScore = 0;
        let playerWeight = 0;

        const len = gameSequence.length;
        if (len >= 3) {
            const l1 = gameSequence[len - 1];
            const l2 = gameSequence[len - 2];
            const l3 = gameSequence[len - 3];

            if (l1 === l2 && l2 === l3) {
                if (l1 === '莊') bankerScore += 4.0;
                else playerWeight += 4.0;
            } else if (l1 !== l2 && l2 !== l3) {
                const predictedJump = (l1 === '莊') ? '閒' : '莊';
                if (predictedJump === '莊') bankerScore += 3.5;
                else playerWeight += 3.5;
            } else if (l1 === l2 && l2 !== l3) {
                if (l1 === '莊') bankerScore += 2.5;
                else playerWeight += 2.5;
            }
        }

        if (bRate >= 60) playerWeight += 2.0;
        else if (pRate >= 60) bankerScore += 2.0;

        if (len >= 1) {
            if (gameSequence[len - 1] === '莊') bankerScore += 1.0;
            else playerWeight += 1.0;
        }

        let targetChoice = '莊';
        let targetColor = '#f87171';
        let cardBorder = 'rgba(239, 68, 68, 0.8)';
        let cardGlow = '0 0 16px rgba(239, 68, 68, 0.5)';

        if (playerWeight > bankerScore) {
            targetChoice = '閒';
            targetColor = '#60a5fa';
            cardBorder = 'rgba(59, 130, 246, 0.8)';
            cardGlow = '0 0 16px rgba(59, 130, 246, 0.5)';
        }

        elTarget.innerText = `【 ${targetChoice} 】`;
        elTarget.style.color = targetColor;
        if (predCard) {
            predCard.style.borderColor = cardBorder;
            predCard.style.boxShadow = cardGlow;
        }
    }

    function startEngineScanner() {
        setInterval(updateHeaderTime, 1000);

        setInterval(() => {
            // 背景持續動態校驗授權狀態
            if (!isAuthorizationValid()) {
                if (container) container.remove();
                showExpiredModal();
                autoDetectEnabled = false;
                return;
            }

            if (!autoDetectEnabled) return;

            const scores = extractLiveScores();
            if (scores) {
                const { b, p, t } = scores;

                if (lastB !== -1 && lastP !== -1) {
                    const currentTotal = b + p;
                    const lastTotal = lastB + lastP;

                    if (currentTotal > lastTotal) {
                        if (b > lastB) gameSequence.push('莊');
                        else if (p > lastP) gameSequence.push('閒');
                        
                        lastB = b;
                        lastP = p;
                        lastT = t;
                        updateCountsAndPredict(b, p, t);
                    } else if (b !== lastB || p !== lastP || t !== lastT) {
                        lastB = b;
                        lastP = p;
                        lastT = t;
                        updateCountsAndPredict(b, p, t);
                    }
                } else {
                    lastB = b;
                    lastP = p;
                    lastT = t;
                    updateCountsAndPredict(b, p, t);
                }
            }
        }, CONFIG.SCAN_INTERVAL);
    }

    const toggleBtn = document.getElementById('btn-toggle-auto');
    toggleBtn.onclick = () => {
        autoDetectEnabled = !autoDetectEnabled;
        if (autoDetectEnabled) {
            toggleBtn.innerText = '自動: 開';
            toggleBtn.style.background = 'linear-gradient(180deg, #22c55e 0%, #15803d 100%)';
            toggleBtn.style.color = '#ffffff';
            toggleBtn.style.borderColor = '#4ade80';
            lastB = -1; lastP = -1; lastT = -1;
            gameSequence = [];
        } else {
            toggleBtn.innerText = '自動: 關';
            toggleBtn.style.background = 'linear-gradient(180deg, rgba(30,30,42,0.8) 0%, rgba(15,15,22,0.9) 100%)';
            toggleBtn.style.color = '#d4af37';
            toggleBtn.style.borderColor = 'rgba(212, 175, 55, 0.3)';
        }
    };

    document.getElementById('btn-clear').onclick = () => {
        lastB = -1; lastP = -1; lastT = -1;
        gameSequence = [];
        updateCountsAndPredict(0, 0, 0);
    };

    updateHeaderTime();
    startEngineScanner();
})();
